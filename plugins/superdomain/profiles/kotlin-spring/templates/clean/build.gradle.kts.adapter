// {{context}}-adapter — Interface Adapters 링(컨트롤러·프레젠터·요청 응답 모델).
// **framework를 의존하지 않는다**(cl.deps-inward) — JPA를 만지는 게이트웨이 구현은 framework의 몫이다.
plugins {
    kotlin("jvm")
}

dependencies {
    implementation(project(":{{context}}-usecase"))
    implementation(project(":{{context}}-domain"))
    implementation("org.springframework.boot:spring-boot-starter-web")
}

// 이 모듈에 `@Transactional`·`@Configuration`처럼 스프링이 프록시로 감싸는 대상이 생기면
// `kotlin("plugin.spring")`을 더한다 — Kotlin 클래스는 기본이 final이다.
