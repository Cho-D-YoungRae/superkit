// {{context}}-presentation — 컨트롤러와 요청·응답 모델.
// 엔티티를 컨트롤러가 직접 다루는 것은 이 스타일에서 규칙 위반이 아니다. 그러려면
// `project(":{{context}}-data")`를 더한다 — 다만 스키마 변경이 곧 API 변경이 된다(스타일 R5).
plugins {
    kotlin("jvm")
}

dependencies {
    implementation(project(":{{context}}-application"))
    implementation("org.springframework.boot:spring-boot-starter-web")
}

// 이 모듈에 `@Transactional`·`@Configuration`처럼 스프링이 프록시로 감싸는 대상이 생기면
// `kotlin("plugin.spring")`을 더한다 — Kotlin 클래스는 기본이 final이다.
