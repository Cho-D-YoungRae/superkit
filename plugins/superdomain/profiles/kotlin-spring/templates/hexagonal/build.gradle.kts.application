// {{context}}-application — 유스케이스와 포트. domain만 안다(hex.deps-inward).
plugins {
    kotlin("jvm")
}

dependencies {
    implementation(project(":{{context}}-domain"))
    // @Service·@Transactional은 이 스타일에서 허용된다 — hex.domain-no-framework의 from에
    // application이 없다. 그것을 막고 싶으면 스타일을 clean으로 바꾸는 것이 답이다.
    // 아래 줄의 주석을 풀 때는 plugins에 `kotlin("plugin.spring")`도 함께 켠다 — Kotlin 클래스는
    // 기본이 final이라 CGLIB이 프록시를 만들지 못하고, 구조 검사는 그것을 보지 못한다.
    // implementation("org.springframework:spring-context")
}
