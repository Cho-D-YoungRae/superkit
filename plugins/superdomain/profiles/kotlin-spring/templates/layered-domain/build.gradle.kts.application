// {{context}}:application — 애플리케이션 서비스와 트랜잭션 경계. domain만 안다.
// **infrastructure를 의존하지 않는다**(ld.infra-isolated) — 그 금지가 인터페이스/구현 분리를
// 규약이 아니라 컴파일로 만든다. @Service·@Transactional은 이 스타일에서 정상이다.
plugins {
    kotlin("jvm")
}

dependencies {
    implementation(project(":{{context}}:domain"))
    implementation("org.springframework:spring-context")
    implementation("org.springframework:spring-tx")
}
