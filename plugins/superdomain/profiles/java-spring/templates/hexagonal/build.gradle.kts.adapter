// {{context}}:adapter — 가장 바깥. application·domain을 안다.
// @Entity는 이 모듈 안에서만 선언·참조된다(hex.domain-pure) — JPA 의존이 여기에만 있는 이유다.
plugins {
    java
}

dependencies {
    implementation(project(":{{context}}:application"))
    implementation(project(":{{context}}:domain"))
    implementation("org.springframework.boot:spring-boot-starter-data-jpa")
    implementation("org.springframework.boot:spring-boot-starter-web")
}

// **Java에서 구조 검사가 보지 못하는 자리 ① — 파라미터 이름.** Spring 6.1부터 `@PathVariable`·
// `@RequestParam`·`@ConfigurationProperties` 생성자 바인딩은 이름을 클래스 파일의 MethodParameters
// 속성에서 읽는다(이전 판의 디버그 정보 폴백이 없어졌다). 그 속성은 `-parameters` 없이는 생기지
// 않고 ✅ 실측, 없으면 `check_imports`도 ArchUnit도 전부 통과한 채 **첫 요청에서** 깨진다
// (`Name for argument of type [...] not specified`). 부트 플러그인이 이 옵션을 넣어 주는 것은
// 앱 모듈뿐이므로(`_shared/build.gradle.kts.app`) 컨트롤러가 사는 이 모듈은 직접 켠다.
tasks.withType<JavaCompile>().configureEach {
    options.compilerArgs.add("-parameters")
}

// **② JPA no-arg 생성자.** Kotlin 프로파일은 `kotlin("plugin.jpa")`로 해결하지만 Java에는 그런
// 플러그인이 없다 — 엔티티 소스가 `protected` 기본 생성자를 직접 갖는다
// (`{{Context}}JpaEntity.java`의 주석). 빌드 조각이 대신해 줄 수 있는 일이 아니다.
